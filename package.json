{
	"name": "obsidian-area",
	"version": "1.0.0",
	"description": "Visual reference collections for Obsidian vaults.",
	"main": "src/main.ts",
	"type": "module",
	"author": "Area contributors",
	"license": "0-BSD",
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"area",
		"gallery",
		"reference",
		"visual-collections"
	],
	"scripts": {
		"dev": "bun bun.build.ts",
		"build": "bun bun.build.ts production",
		"version": "bun version-bump.mjs && git add manifest.json versions.json",
		"lint": "bunx biome lint src/",
		"lint:fix": "bunx biome lint --write src/",
		"format": "bunx biome format --write src/",
		"type-check": "bunx tsc --noEmit",
		"test": "bun test",
		"clean": "bun bun.build.ts clean",
		"dev:install": "bun bun.build.ts install",
		"setup": "cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit && echo 'Pre-commit hook installed.'"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@types/bun": "^1.3.14",
		"obsidian": "^1.13.1",
		"obsidian-typings": "^6.19.0",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3"
	}
}
